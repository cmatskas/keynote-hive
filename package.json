{
  "name": "Hive",
  "version": "4.0.0",
  "description": "Electron app for Bedrock models and media transcription",
  "main": "main.js",
  "author": "Hive Team",
  "homepage": "https://hive.app",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "publish": "./build-scripts/publish.sh all",
    "publish:mac": "./build-scripts/publish.sh mac",
    "publish:win": "./build-scripts/publish.sh win",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "node tests/integration/mantle-live.js",
    "test:integration:aws": "node tests/integration/setup-check-live.js",
    "test:code-interpreter": "node tests/diag-code-interpreter.js",
    "test:memory": "node tests/diag-memory.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-bedrock": "^3.1092.0",
    "@aws-sdk/client-bedrock-agent": "^3.1092.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1092.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1092.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1092.0",
    "@aws-sdk/client-iam": "^3.1092.0",
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/client-sagemaker-runtime": "^3.1092.0",
    "@aws-sdk/client-sts": "^3.1092.0",
    "@aws-sdk/client-transcribe": "^3.1092.0",
    "@aws-sdk/credential-providers": "^3.1092.0",
    "@aws-sdk/lib-storage": "^3.1092.0",
    "@aws/bedrock-token-generator": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@popperjs/core": "^2.11.8",
    "@smithy/protocol-http": "^5.5.12",
    "@smithy/signature-v4": "^5.6.8",
    "@strands-agents/sdk": "^1.12.0",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "^1.11.1",
    "docx": "^9.7.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.7",
    "openai": "^6.49.0",
    "sortablejs": "^1.15.7",
    "toastify-js": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1"
  },
  "jest": {
    "testEnvironment": "jest-environment-jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "!**/tests/integration/**"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "testTimeout": 30000
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "com.hive.app",
    "productName": "Hive",
    "directories": {
      "output": "dist/temp"
    },
    "files": [
      "**/*",
      "!tests/**/*",
      "!coverage/**/*",
      "!dist/**/*"
    ],
    "artifactName": "${productName}-${version}-${platform}-${arch}.${ext}",
    "mac": {
      "icon": "src/assets/app.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-universal.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false
    },
    "win": {
      "icon": "src/assets/favicon-win.ico",
      "target": "nsis",
      "artifactName": "${productName}-${version}-Setup-${arch}.${ext}"
    },
    "linux": {
      "icon": "src/assets/favicon_512x512.png",
      "category": "AudioVideo",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "cmatskas",
      "repo": "keynote-hive"
    }
  }
}
